{
  "name": "Order",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "restaurant_owner_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "picked_up",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "menu_item_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "video_url": {
            "type": "string"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "delivery_address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "paid"
    },
    "delivery_fee": {
      "type": "number",
      "default": 2.99
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "creator_id": {
      "type": "string"
    },
    "commission_amount": {
      "type": "number",
      "default": 0
    },
    "order_type": {
      "type": "string",
      "enum": [
        "delivery",
        "pickup"
      ],
      "default": "delivery"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_instructions": {
      "type": "string"
    },
    "promo_code": {
      "type": "string"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "customer_phone": {
      "type": "string"
    },
    "pickup_code": {
      "type": "string"
    },
    "delivery_pin": {
      "type": "string"
    },
    "pickup_confirmed": {
      "type": "boolean",
      "default": false
    },
    "pickup_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_proof_url": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "items",
    "total_amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.restaurant_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.restaurant_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.restaurant_owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}