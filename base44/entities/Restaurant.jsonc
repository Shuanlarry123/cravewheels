{
  "name": "Restaurant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "cuisine_type": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "phone": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 4.5
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    },
    "delivery_fee": {
      "type": "number",
      "default": 2.99
    },
    "delivery_radius_km": {
      "type": "number",
      "default": 10
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "is_live": {
      "type": "boolean",
      "default": false
    },
    "live_stream_url": {
      "type": "string"
    },
    "kitchen_video_url": {
      "type": "string"
    },
    "stripe_cardholder_id": {
      "type": "string"
    },
    "stripe_card_id": {
      "type": "string"
    },
    "stripe_card_last4": {
      "type": "string"
    },
    "stripe_card_brand": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}