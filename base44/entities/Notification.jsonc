{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "default": "order_assigned"
    },
    "order_id": {
      "type": "string"
    },
    "link": {
      "type": "string",
      "default": "/driver"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "body"
  ]
}